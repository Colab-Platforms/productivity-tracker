// Employee profile photos: format detection and who may change / see one. No database.
import { canChangePhoto, canViewPhoto, MAX_PHOTO_BYTES, sniffImage } from "../src/modules/photos/photos.logic.js";
let pass = 0, fail = 0;
const ok = (n: string, c: boolean) => { c ? pass++ : fail++; console.log((c ? "PASS " : "FAIL ") + n); };
const jpg = Uint8Array.from([0xff, 0xd8, 0xff, 0xe0, 0, 0x10]);
const png = Uint8Array.from([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a, 0, 0]);
const webp = Uint8Array.from([0x52, 0x49, 0x46, 0x46, 1, 2, 3, 4, 0x57, 0x45, 0x42, 0x50]);
const text = (s: string) => Uint8Array.from(Buffer.from(s));
ok("a JPEG is recognised", sniffImage(jpg) === "image/jpeg");
ok("a PNG is recognised", sniffImage(png) === "image/png");
ok("a WebP is recognised", sniffImage(webp) === "image/webp");
ok("a PDF is refused", sniffImage(text("%PDF-1.7 ....")) === null);
ok("an SVG (script can hide in it) is refused", sniffImage(text('<svg xmlns="http://www.w3.org/2000/svg"><script/></svg>')) === null);
ok("an HTML file renamed .jpg is refused", sniffImage(text("<html><script>alert(1)</script></html>")) === null);
ok("a GIF is refused", sniffImage(text("GIF89a......")) === null);
ok("an empty file is refused", sniffImage(new Uint8Array()) === null);
ok("a RIFF file that is not WebP (a WAV) is refused", sniffImage(Uint8Array.from([0x52, 0x49, 0x46, 0x46, 1, 2, 3, 4, 0x57, 0x41, 0x56, 0x45])) === null);
ok("the limit is 2 MB", MAX_PHOTO_BYTES === 2 * 1024 * 1024);
const acc = (ids: string[], all = false) => ({ all, ids });
ok("HR of the company can change a photo", canChangePhoto({ role: "HR", access: acc(["P1"]) }, "P1"));
ok("HR of another company cannot", !canChangePhoto({ role: "HR", access: acc(["P1"]) }, "P2"));
ok("HR assigned a second company can", canChangePhoto({ role: "HR", access: acc(["P1", "P2"]) }, "P2"));
ok("top management can, anywhere", canChangePhoto({ role: "ADMIN", access: acc([], true) }, "P9"));
ok("an Admin without access to that company cannot", !canChangePhoto({ role: "ADMIN", access: acc(["P1"]) }, "P9"));
ok("an employee cannot change any photo, not even their own", !canChangePhoto({ role: "EMPLOYEE", access: acc(["P1"]) }, "P1"));
ok("a manager cannot either", !canChangePhoto({ role: "MANAGER", access: acc(["P1"]) }, "P1"));
const v = (over = {}) => ({ id: "me", platformId: "P1", role: "EMPLOYEE", access: acc(["P1"]), ...over });
ok("you see your own photo", canViewPhoto(v(), { id: "me", platformId: "P1" }));
ok("you see a colleague's photo in your company", canViewPhoto(v(), { id: "x", platformId: "P1" }));
ok("you do not see a photo from another company", !canViewPhoto(v(), { id: "x", platformId: "P2" }));
ok("HR assigned that company does", canViewPhoto(v({ role: "HR", access: acc(["P1", "P2"]) }), { id: "x", platformId: "P2" }));
console.log(`\n${pass} passed, ${fail} failed`);
process.exit(fail ? 1 : 0);
