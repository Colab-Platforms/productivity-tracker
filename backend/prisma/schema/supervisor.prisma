// A Productivity Supervisor stays an EMPLOYEE for every personal feature; this table adds read-only organisation-wide monitoring on top.
// New table only; written by a script, never by an API route. No relation on User (the foreign key lives in the migration only).
model ProductivitySupervisor {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  note      String?
  createdAt DateTime @default(now())

  @@map("productivity_supervisors")
}
