// Quick Add drafts: a person's own unsent task rows. NEW TABLE ONLY. A draft is NOT a task: it is never read by reports, the review queue,
// notifications or productivity. Nothing here has a foreign-key relation in Prisma (the foreign keys live in the migration).
model TaskDraft {
  id              String   @id @default(uuid()) @db.Uuid
  platformId      String   @db.Uuid
  userId          String   @db.Uuid
  sortOrder       Int      @default(0)
  title           String   @default("")
  description     String?
  teamId          String?  @db.Uuid
  taggedManagerId String?  @db.Uuid
  hoursSpent      Float?
  weight          String   @default("MEDIUM")
  progress        String   @default("IN_PROGRESS")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, sortOrder])
  @@map("task_drafts")
}
